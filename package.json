{
  "name": "@wenex/client-sdk",
  "version": "1.0.0",
  "description": "Client SDK",
  "main": "index.js",
  "types": "index.d.ts",
  "author": "Vahid V. <vhid.vz@gmail.com>",
  "bugs": {
    "url": "https://github.com/wenex-org/client-sdk/issues"
  },
  "keywords": [
    "sdk",
    "client",
    "client-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenex-org/client-sdk.git"
  },
  "homepage": "https://github.com/wenex-org/client-sdk#readme",
  "scripts": {
    "link:dev": "tsc -p ./tsconfig.json && pnpm link --global && pnpm run dev",
    "link": "tsc -p ./tsconfig.json && pnpm link --global",
    "unlink": "rm -rf $PNPM_HOME/global",
    "dev": "tsc -p ./tsconfig.json --watch",
    "build": "tsc -p ./tsconfig.json",
    "prebuild": "rimraf tsconfig.tsbuildinfo index.* common services",
    "prepare": "echo -e prepare for development by: npm run husky",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --quiet --fix",
    "test": "jest",
    "husky": "husky",
    "test:cov": "jest --coverage && npm run make-coverage-badge",
    "doc": "npx typedoc --entryPointStrategy expand --out docs src/",
    "check": "madge --circular --warning --ts-config ./tsconfig.json --extensions ts --image circular-dependencies.png ./src",
    "make-coverage-badge": "make-coverage-badge --report-path coverage/coverage-summary.json --output-path coverage-badge.svg",
    "git": "bash ./scripts/git-submodule.sh",
    "git:remote:add": "bash ./scripts/git-remote-add.sh"
  },
  "lint-staged": {
    "*.ts": [
      "npm run format",
      "npm run lint"
    ]
  },
  "dependencies": {
    "axios": "^1.11.0"
  },
  "peerDependencies": {
    "@wenex/sdk": ">=1.3.4 <2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "files": [
    "/common",
    "/services",
    "/index.js",
    "/index.d.ts",
    "/index.js.map"
  ],
  "engines": {
    "node": ">=22.x.x <23",
    "npm": "~10.9.2"
  },
  "os": [
    "!win32"
  ],
  "packageManager": "pnpm@10.5.2"
}
